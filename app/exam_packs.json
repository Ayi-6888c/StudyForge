      "modules": [
        {
          "id": "io",
          "title": "输入输出与顺序程序",
          "prerequisites": [],
          "weight": 2,
          "concepts": "程序骨架、变量、printf/scanf、整除与取模",
          "exit_standard": "独立写两数运算、矩形面积、三位数拆分；说明每个格式符和取地址符的作用。"
        },
        {
          "id": "types",
          "title": "类型与表达式",
          "prerequisites": [
            "io"
          ],
          "weight": 3,
          "concepts": "整数/实数、转换、优先级、逻辑与短路",
          "exit_standard": "先手算再运行；区分整数除法和实数除法，解释每次类型转换。"
        },
        {
          "id": "branch",
          "title": "选择结构",
          "prerequisites": [
            "types"
          ],
          "weight": 3,
          "concepts": "if/else、switch、边界与多条件",
          "exit_standard": "列出条件分区，测试等号两侧及临界值；避免连写数学不等式。"
        },
        {
          "id": "loop",
          "title": "循环与数值算法",
          "prerequisites": [
            "branch"
          ],
          "weight": 6,
          "concepts": "for/while/do-while、嵌套、break/continue",
          "exit_standard": "能手工跟踪循环变量和累加器；从求和扩展到素数、数位和与迭代。"
        },
        {
          "id": "arrays",
          "title": "数组与排序查找",
          "prerequisites": [
            "loop"
          ],
          "weight": 5,
          "concepts": "一维/二维数组、遍历、排序、查找",
          "exit_standard": "理解合法下标，手写冒泡/选择排序、顺序/二分查找与矩阵处理。"
        },
        {
          "id": "strings",
          "title": "字符与字符串",
          "prerequisites": [
            "arrays"
          ],
          "weight": 4,
          "concepts": "字符数组、终止符、字符串函数",
          "exit_standard": "区分容量与长度；使用有界输入，处理空串、空格和末尾换行。"
        },
        {
          "id": "functions",
          "title": "函数与递归",
          "prerequisites": [
            "loop",
            "arrays"
          ],
          "weight": 5,
          "concepts": "参数、返回值、作用域、递归、静态变量",
          "exit_standard": "把算法拆成函数，追踪值传递和递归调用；说明递归终止条件。"
        },
        {
          "id": "pointers",
          "title": "指针与数据传递",
          "prerequisites": [
            "arrays",
            "functions",
            "strings"
          ],
          "weight": 6,
          "concepts": "地址、解引用、指针与数组、指针参数",
          "exit_standard": "画内存示意图；独立用指针交换变量、遍历数组并返回统计结果。"
        },
        {
          "id": "structs",
          "title": "结构体与自定义类型",
          "prerequisites": [
            "pointers"
          ],
          "weight": 4,
          "concepts": "结构体、结构体数组、typedef、枚举",
          "exit_standard": "设计学生记录并排序统计；区分结构体成员访问与结构体指针访问。"
        },
        {
          "id": "preproc",
          "title": "预处理与综合语法",
          "prerequisites": [
            "types",
            "functions"
          ],
          "weight": 2,
          "concepts": "宏、条件编译、作用域与存储期",
          "exit_standard": "展开宏后再计算，识别括号和重复求值风险；不背编译器特定字节数。"
        },
        {
          "id": "files",
          "title": "文件操作",
          "prerequisites": [
            "strings",
            "pointers",
            "structs"
          ],
          "weight": 3,
          "concepts": "FILE、打开关闭、顺序读写、EOF",
          "exit_standard": "逐次判断读取函数返回值；处理打开失败，解释文本文件与二进制文件差别。"
        },
        {
          "id": "algorithms",
          "title": "综合算法与纸笔编程",
          "prerequisites": [
            "loop",
            "arrays",
            "functions",
            "pointers"
          ],
          "weight": 5,
          "concepts": "算法分解、复杂度直觉、综合程序与边界测试",
          "exit_standard": "限时完成需求分析、伪代码、C实现、手工跟踪及测试表。"
        }
      ],
      "training_note": "章节顺序、掌握门槛、复习间隔和模拟分值分配是本软件的教学设计，不是官方细分考点或分值承诺。",
